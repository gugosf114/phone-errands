#!/usr/bin/env python3
"""Run a support-chat errand through the personal Claude brain and shared job record."""
import argparse
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from assistant_records import request, read_card

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('card', help='Text or JSON goal card; include who, goal, and a support URL when known')
parser.add_argument('--dry', action='store_true', help='Show the request')
args = parser.parse_args()
try:
    card = read_card(args.card)
    body = {'task': card['goal'], 'card': card, 'channel': 'support-chat'}
    print(json.dumps(body if args.dry else request('POST', '/jobs', body), indent=2, ensure_ascii=False))
except Exception as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
