#!/usr/bin/env python3
"""Send work to the same personal brain from a terminal or chat; inspect its receipts."""
import argparse
import json
import subprocess
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from assistant_records import request, read_card, receipt, flush
from voice_catalog import catalog, resolve_call_voice
import profile_store


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    submit = sub.add_parser('submit', help='Give the brain a goal card')
    submit.add_argument('card')
    submit.add_argument('--channel', choices=['auto', 'phone', 'support-chat'])
    submit.add_argument('--preview', action='store_true')
    ask = sub.add_parser('ask', help='Give the brain a task in plain words')
    ask.add_argument('task')
    ask.add_argument('--channel', default='auto', choices=['auto', 'phone', 'support-chat'])
    jobs = sub.add_parser('jobs', help='List jobs or read one complete record')
    jobs.add_argument('id', nargs='?')
    sub.add_parser('status')
    profile = sub.add_parser('profile', help='Show saved field names or import identity facts')
    profile.add_argument('--import-file')
    sub.add_parser('accounts', help='List saved company accounts')
    acct = sub.add_parser('account', help='Read or import a company account')
    acct.add_argument('key')
    acct.add_argument('--import-file')
    ctx = sub.add_parser('context', help='Read the personal and account facts for an errand')
    ctx.add_argument('--account')
    ctx.add_argument('--verification', action='store_true')
    voice = sub.add_parser('voice', help='Render a preview of an imported George voice')
    voice.add_argument('--voice', choices=['george-natural', 'majestic-george'], default='george-natural')
    voice.add_argument('--text', required=True)
    voice.add_argument('--out', required=True)
    sub.add_parser('flush', help='Attach receipts saved while the bridge was unavailable')
    rec = sub.add_parser('receipt', help='Attach proof or an outcome to a job')
    rec.add_argument('job_id')
    rec.add_argument('--summary', required=True)
    rec.add_argument('--channel', default='support-chat')
    rec.add_argument('--outcome', choices=['achieved', 'partial', 'refused', 'needs-input', 'in-progress'], required=True)
    rec.add_argument('--url')
    rec.add_argument('--path')
    rec.add_argument('--confirmation')
    args = parser.parse_args()
    if args.command == 'voice':
        root = Path(__file__).resolve().parent
        if args.voice == 'majestic-george':
            command = [catalog()['assetDirectory'] + '/venv/bin/python', str(root / 'scripts/render-george.py'), '--text', args.text, '--out', args.out]
        else:
            command = [sys.executable, str(root / 'scripts/bland-voice.py'), 'speak', '--voice', resolve_call_voice(args.voice), '--text', args.text, '--out', args.out]
        subprocess.run(command, check=True)
        return
    if args.command == 'submit':
        card = read_card(args.card)
        body = {'task': card['goal'], 'card': card, 'channel': args.channel or card.get('channel', 'auto')}
        result = body if args.preview else request('POST', '/jobs', body)
    elif args.command == 'ask':
        result = request('POST', '/jobs', {'task': args.task, 'channel': args.channel})
    elif args.command == 'jobs':
        result = request('GET', '/jobs' + ('/' + args.id if args.id else ''))
    elif args.command == 'profile':
        if args.import_file:result=profile_store.save_identity(args.import_file)
        else:
            data=profile_store.load()
            result={'savedFields':list(data.get('identity',{})), 'updatedAt':data.get('updatedAt'), 'sources':data.get('sources',{})}
    elif args.command == 'accounts':
        result=profile_store.accounts()
    elif args.command == 'account':
        result=profile_store.save_account(args.key,args.import_file) if args.import_file else profile_store.account(args.key)
    elif args.command == 'context':
        result=profile_store.context({'account':args.account} if args.account else {},args.verification)
    elif args.command == 'status':
        result = request('GET', '/status')
    elif args.command == 'flush':
        result = {'receiptsAttached': flush()}
    else:
        result = receipt({k: v for k, v in vars(args).items() if k not in ('command', 'job_id') and v is not None}, args.job_id)
    print(json.dumps(result, indent=2, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
